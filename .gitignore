# Default-deny: the root is a full game install plus the UE3 source tree, which
# must never be published wholesale. Only files that differ from the original
# engine are tracked. Tracked files are unaffected by these rules.
# Use Development/Src/Targets/git_track.py to find and add changed engine files.
/*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/.github/
!/CI/
!/docs/
!/README.md
!/README_RU.md

# Own code: new files here show up in `git status` without any extra step.
!/Development/
/Development/*
!/Development/Src/
/Development/Src/*
!/Development/Src/Multiplayer/
/Development/Src/Multiplayer/*
!/Development/Src/Multiplayer/Classes/
!/Development/Src/Multiplayer/Inc/
!/Development/Src/Multiplayer/Src/
!/Development/Src/Multiplayer/Tests/
!/Development/Src/Multiplayer/*.md
/Development/Src/Multiplayer/ARCHITECTURE*.md
/Development/Src/Multiplayer/GIT_AND_HEADLESS.md
!/Development/Src/Multiplayer/server
!/Development/Src/TASGame/
!/Development/Src/Targets/
/Development/Src/Targets/*
!/Development/Src/Targets/*.sh
!/Development/Src/Targets/*.py
!/Development/External/
/Development/External/*
!/Development/External/imgui/
/Development/External/imgui/.vs/
/Development/External/imgui/obj/
/Development/External/imgui/lib/
!/Development/External/openol_relay/
/Development/External/openol_relay/.vs/
/Development/External/openol_relay/obj/
/Development/External/openol_relay/lib/
# Only our part of the browser: the rest is the CEF distribution and build output.
!/Development/External/openol_browser/
/Development/External/openol_browser/*
!/Development/External/openol_browser/src/
!/Development/External/openol_browser/OpenOL_Browser.vcxproj
!/Binaries/
/Binaries/*
!/Binaries/Win64/
/Binaries/Win64/*
!/Binaries/Win64/OpenOL/
/Binaries/Win64/OpenOL/settings.ini
*.vcxproj.user

*.obj
*.exe
*.u
__pycache__/

# clangd-only helper symlinks (case-alias headers + Wine SDK shim), not real project files
.clangd-msvc-shim/
compile_commands.json
