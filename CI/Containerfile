FROM ubuntu:24.04

# MAKE SURE TO HAVE OUTLAST SRC DOWNLOADED IN THE SAME DIR AS THE ROOT OF THIS REPOSITORY.
# I haven't tested this due to not having a vps with enough storage but
# it should work I don't see a reason why it shouldn't.

ENV DEBIAN_FRONTEND=noninteractive
ENV WINEPREFIX="/home/builder/.local/share/prefixes/OL1Compile"
ENV OL1_WINEPREFIX="/home/builder/.local/share/prefixes/OL1Compile"
#ENV WINEDEBUG=fixme-all # Uncomment once tested
ENV WINEDLLOVERRIDES="winemenubuilder.exe=d"
ENV XDG_RUNTIME_DIR=/build/xdg
#ENV WLR_RENDERER=pixman # DO NOT UNCOMMENT THIS UNLESS YOU HAVE TO

# Install dependencies
RUN dpkg --add-architecture i386
RUN apt-get update && apt-get install -y \
    sudo \
    curl \
    wget \
    winetricks \
    gnupg2 \
    ca-certificates \
    tar \
    xz-utils \
    git \
    p7zip-full \
    cage \
    xwayland-run \
    winbind \
    msitools \
    libwbclient0 \
    libwbclient-dev \
    lib32gcc-s1 \
    lib32stdc++6 \
    libc6-i386 \
    libegl1 \
    libegl1:i386 \
    libegl-mesa0:i386 \
    libgl1 \
    libgl1:i386 \
    libglx0 \
    libglx0:i386 \
    libgles2:i386 \
    libgl1-mesa-dri \
    libgl1-mesa-dri:i386 \
    libvulkan1 \
    libvulkan1:i386 \
    mesa-vulkan-drivers \
    mesa-vulkan-drivers:i386

# ---- WineHQ ----
RUN mkdir -pm755 /etc/apt/keyrings && \
    curl -fsSL https://dl.winehq.org/wine-builds/winehq.key \
        -o /etc/apt/keyrings/winehq-archive.key && \
    curl -fsSL https://dl.winehq.org/wine-builds/ubuntu/dists/noble/winehq-noble.sources \
        -o /etc/apt/sources.list.d/winehq-noble.sources && \
    apt-get update && \
    apt-get install -y --install-recommends winehq-devel && \
    rm -rf /var/lib/apt/lists/*

# Create build user
RUN useradd -m builder && \
    echo "builder ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

USER builder

RUN mkdir -p /build/xdg

COPY --chown=builder:builder Outlast1.7z /build

RUN 7z x /build/Outlast1.7z \
    'DATA/D/Perforce_Server1/outlast/UnrealEngine3/Binaries/*' \
    'DATA/D/Perforce_Server1/outlast/UnrealEngine3/Development/External/*' \
    'DATA/D/Perforce_Server1/outlast/UnrealEngine3/Development/Src/*' \
    'DATA/D/Perforce_Server1/outlast/UnrealEngine3/Development/Tools/*' \
    'DATA/D/Perforce_Server1/outlast/UnrealEngine3/Engine/*' \
    'DATA/D/Perforce_Server1/outlast/UnrealEngine3/OLGame/*' \
    -o/build

WORKDIR /build/DATA/D/Perforce_Server1/outlast/UnrealEngine3/

# Copy repo files
COPY --chown=builder:builder Development/ /build/DATA/D/Perforce_Server1/outlast/UnrealEngine3/Development/
COPY --chown=builder:builder OLGame/ /build/DATA/D/Perforce_Server1/outlast/UnrealEngine3/OLGame/
COPY --chown=builder:builder Binaries/ /build/DATA/D/Perforce_Server1/outlast/UnrealEngine3/Binaries/

# Prepare wineprefix
RUN mkdir -p $WINEPREFIX

# Download SDKs
RUN wget https://archive.org/download/en_visual_studio_professional_2012_x86_dvd/Visual%20Studio%20Professional%202012%20%28x86%29%20-%20DVD%20%28English%29/en_visual_studio_professional_2012_x86_dvd_2262334.iso
RUN wget https://download.microsoft.com/download/A/E/7/AE743F1F-632B-4809-87A9-AA1BB3458E31/DXSDK_Jun10.exe

# Create prefix headlessly
RUN mkdir -p $WINEPREFIX $XDG_RUNTIME_DIR && \
    wineboot -u 2>/dev/null; \
    wineserver -w; \
    wget -q https://dl.winehq.org/wine/wine-mono/11.2.0/wine-mono-11.2.0-x86.msi && \
    wine msiexec /i wine-mono-11.2.0-x86.msi 2>/dev/null; \
    wineserver -w; \
    rm -f wine-mono-11.2.0-x86.msi; \
    wine reg add "HKEY_CURRENT_USER\\Software\\Wine\\Drivers" \
        /v Graphics /t REG_SZ /d wayland /f 2>/dev/null; \
    wineserver -w; \
    echo "PREFIX READY"

RUN wlheadless-run -c cage -- winetricks -q dotnet20 dotnet40 gdiplus corefonts riched20 atmlib msxml3 msls31

RUN 7z x \
    /build/DATA/D/Perforce_Server1/outlast/UnrealEngine3/en_visual_studio_professional_2012_x86_dvd_2262334.iso \
    -o/build/DATA/D/Perforce_Server1/outlast/UnrealEngine3/

COPY --chown=builder:builder CI/AdminDeployment.xml /build/DATA/D/Perforce_Server1/outlast/UnrealEngine3/

RUN wlheadless-run -c cage -- wine vs_professional.exe /AdminFile AdminDeployment.xml /quiet /norestart

RUN wlheadless-run -c cage -- wine DXSDK_Jun10.exe /U

RUN chmod +x /build/DATA/D/Perforce_Server1/outlast/UnrealEngine3/Development/Src/Targets/*.sh

RUN /build/DATA/D/Perforce_Server1/outlast/UnrealEngine3/Development/Src/Targets/build_wine.sh 6 \
    && /build/DATA/D/Perforce_Server1/outlast/UnrealEngine3/Development/Src/Targets/release.sh build-archives

CMD ["/bin/bash"]
